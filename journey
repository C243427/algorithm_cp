#include <bits/stdc++.h>
using namespace std;

const int N = 100005;

vector<int> adj[N];
double ans = 0.0;

void dfs(int u, int par, double prob, int dist) {

    int child = 0;

    for(int v : adj[u]) {
        if(v != par) child++;
    }

    if(child == 0) {
        ans += prob * dist;
        return;
    }

    for(int v : adj[u]) {
        if(v == par) continue;
        dfs(v, u, prob / child, dist + 1);
    }
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    cin >> n;

    for(int i = 0; i < n - 1; i++) {
        int u, v;
        cin >> u >> v;
        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    dfs(1, 0, 1.0, 0);

    cout << fixed << setprecision(15) << ans << "\n";
}
