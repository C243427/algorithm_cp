class Solution {
public:
    int minimumEffortPath(vector<vector<int>>& heights) {

        int n = heights.size();
        int m = heights[0].size();

        vector<vector<int>> dist(n, vector<int>(m, INT_MAX));

        priority_queue<
            vector<int>,
            vector<vector<int>>,
            greater<vector<int>>
        > pq;

        dist[0][0] = 0;
        pq.push({0, 0, 0}); 

        vector<int> dx = {-1, 1, 0, 0};
        vector<int> dy = {0, 0, -1, 1};

        while (!pq.empty()) {

            auto cur = pq.top();
            pq.pop();

            int effort = cur[0];
            int x = cur[1];
            int y = cur[2];

            if (x == n - 1 && y == m - 1)
                return effort;

            for (int i = 0; i < 4; i++) {

                int nx = x + dx[i];
                int ny = y + dy[i];

                if (nx >= 0 && nx < n &&
                    ny >= 0 && ny < m) {

                    int newEffort = max(
                        effort,
                        abs(heights[x][y] - heights[nx][ny])
                    );

                    if (newEffort < dist[nx][ny]) {

                        dist[nx][ny] = newEffort;
                        pq.push({newEffort, nx, ny});
                    }
                }
            }
        }

        return 0;
    }
};
