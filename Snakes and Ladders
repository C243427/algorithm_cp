class Solution {
public:
    int snakesAndLadders(vector<vector<int>>& board) {
        int n = board.size();

        vector<int> cells(1); 

        bool leftToRight = true;

        for (int r = n - 1; r >= 0; r--) {
            if (leftToRight) {
                for (int c = 0; c < n; c++)
                    cells.push_back(board[r][c]);
            } else {
                for (int c = n - 1; c >= 0; c--)
                    cells.push_back(board[r][c]);
            }

            leftToRight = !leftToRight;
        }

        queue<int> q;
        vector<bool> vis(n * n + 1, false);

        q.push(1);
        vis[1] = true;

        int moves = 0;

        while (!q.empty()) {
            int sz = q.size();

            while (sz--) {
                int cur = q.front();
                q.pop();

                if (cur == n * n)
                    return moves;

                for (int d = 1; d <= 6 && cur + d <= n * n; d++) {
                    int nxt = cur + d;

                    if (cells[nxt] != -1)
                        nxt = cells[nxt];

                    if (!vis[nxt]) {
                        vis[nxt] = true;
                        q.push(nxt);
                    }
                }
            }

            moves++;
        }

        return -1;
    }
};
