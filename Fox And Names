#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    cin >> n;

    vector<string> s(n);

    for (int i = 0; i < n; i++)
        cin >> s[i];

    vector<vector<int>> adj(26);
    vector<int> indeg(26, 0);

    bool ok = true;

    for (int i = 0; i < n - 1; i++) {

        string a = s[i];
        string b = s[i + 1];

        int len = min(a.size(), b.size());
        int j = 0;

        while (j < len && a[j] == b[j])
            j++;

        if (j == len) {

            if (a.size() > b.size())
                ok = false;

            continue;
        }

        int u = a[j] - 'a';
        int v = b[j] - 'a';

        adj[u].push_back(v);
    }

    if (!ok) {
        cout << "Impossible\n";
        return 0;
    }

    for (int u = 0; u < 26; u++) {
        sort(adj[u].begin(), adj[u].end());
        adj[u].erase(unique(adj[u].begin(),
                            adj[u].end()),
                     adj[u].end());

        for (int v : adj[u])
            indeg[v]++;
    }

    queue<int> q;

    for (int i = 0; i < 26; i++) {
        if (indeg[i] == 0)
            q.push(i);
    }

    string ans = "";

    while (!q.empty()) {

        int u = q.front();
        q.pop();

        ans += char('a' + u);

        for (int v : adj[u]) {

            indeg[v]--;

            if (indeg[v] == 0)
                q.push(v);
        }
    }

    if ((int)ans.size() != 26) {
        cout << "Impossible\n";
        return 0;
    }

    cout << ans << "\n";

    return 0;
}
