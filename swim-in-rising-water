class Solution {
public:
    int swimInWater(vector<vector<int>>& grid) {

        int n = grid.size();

        priority_queue<
            vector<int>,
            vector<vector<int>>,
            greater<vector<int>>
        > pq;

        vector<vector<int>> dist(n, vector<int>(n, INT_MAX));

        dist[0][0] = grid[0][0];
        pq.push({grid[0][0], 0, 0});

        vector<int> dx = {-1, 1, 0, 0};
        vector<int> dy = {0, 0, -1, 1};

        while (!pq.empty()) {

            auto cur = pq.top();
            pq.pop();

            int time = cur[0];
            int x = cur[1];
            int y = cur[2];

            if (x == n - 1 && y == n - 1)
                return time;

            for (int i = 0; i < 4; i++) {

                int nx = x + dx[i];
                int ny = y + dy[i];

                if (nx < 0 || ny < 0 || nx >= n || ny >= n)
                    continue;

                int newTime = max(time, grid[nx][ny]);

                if (newTime < dist[nx][ny]) {
                    dist[nx][ny] = newTime;
                    pq.push({newTime, nx, ny});
                }
            }
        }

        return -1;
    }
};
