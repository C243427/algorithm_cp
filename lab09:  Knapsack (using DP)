#include <iostream>
using namespace std;
int main() {
    int n, W;
    cout << "Enter number of items: ";
    cin >> n;
    int weight[100], value[100];  
    cout << "Enter weights:\n";
    for(int i = 0; i < n; i++) {
        cin >> weight[i];
    }
    cout << "Enter values:\n";
    for(int i = 0; i < n; i++) {
        cin >> value[i];
    }
    cout << "Enter knapsack capacity: ";
    cin >> W;
    int dp[100][100]; 
    for(int i = 0; i <= n; i++) {
        for(int w = 0; w <= W; w++) {
            if(i == 0 || w == 0)
                dp[i][w] = 0;
        }
    }
    for(int i = 1; i <= n; i++) {
        for(int w = 1; w <= W; w++) {
            if(weight[i-1] <= w) {
                int take = value[i-1] + dp[i-1][w - weight[i-1]];
                int notTake = dp[i-1][w];
                dp[i][w] = (take > notTake) ? take : notTake;
            } else {
                dp[i][w] = dp[i-1][w];
            }
        }
    }
    cout << "Maximum Value = " << dp[n][W] << endl;
    return 0;
}
