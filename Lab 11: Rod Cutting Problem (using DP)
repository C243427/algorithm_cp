#include <iostream>
using namespace std;
int main() {
    int n;
    cout << "Enter rod length: ";
    cin >> n;
    int price[100];
    cout << "Enter prices for each length:\n";
    for(int i = 1; i <= n; i++) {
        cin >> price[i];
    }
    int dp[100];
    int cut[100];   
    dp[0] = 0;
    for(int i = 1; i <= n; i++) {
        int max_val = -1;
        for(int j = 1; j <= i; j++) {
            if(max_val < price[j] + dp[i - j]) {
                max_val = price[j] + dp[i - j];
                cut[i] = j;   
            }
        }
        dp[i] = max_val;
    }
    cout << "Maximum Value = " << dp[n] << endl;
    cout << "Cuts: ";
    while(n > 0) {
        cout << cut[n];
        n = n - cut[n];
        if(n > 0) cout << ",";
    }
    cout << endl;
    return 0;
}
